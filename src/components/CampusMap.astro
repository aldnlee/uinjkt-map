---
// src/components/CampusMap.astro
---

<div class="relative w-full max-w-6xl mx-auto px-2 sm:px-4 space-y-4">
  <!-- SEARCH BAR BOX -->
  <div class="relative z-20 max-w-xl mx-auto">
    <div class="relative flex items-center bg-white/95 backdrop-blur-md rounded-2xl shadow-lg border border-slate-200/80 transition-all focus-within:ring-2 focus-within:ring-emerald-500 focus-within:border-emerald-500 overflow-hidden px-3.5 py-1.5">
      <span class="text-slate-400 text-lg mr-2">🔍</span>
      <input 
        type="text" 
        id="search-input" 
        placeholder="Cari gedung, fakultas, lab, kantin, atau unit layanan..." 
        class="w-full bg-transparent text-sm text-slate-800 placeholder-slate-400 focus:outline-none py-1.5"
        autocomplete="off"
      />
      <button id="btn-clear-search" class="text-slate-400 hover:text-slate-600 hidden text-xs bg-slate-100 hover:bg-slate-200 px-2 py-1 rounded-full font-bold transition-all">
        ✕
      </button>
    </div>

    <!-- Dropdown Hasil Pencarian -->
    <div 
      id="search-results" 
      class="absolute left-0 right-0 top-full mt-2 bg-white/95 backdrop-blur-md rounded-2xl shadow-2xl border border-slate-200/90 max-h-72 overflow-y-auto hidden z-30 divide-y divide-slate-100 transition-all animate-in fade-in zoom-in-95 duration-150"
    ></div>
  </div>

  <!-- Container Peta & Tombol Live Sync -->
  <div class="relative">
    <div 
      id="map" 
      class="w-full rounded-2xl shadow-2xl border border-slate-300 bg-slate-200 z-0 relative overflow-hidden" 
      style="height: 600px; min-height: 600px;"
    >
      <div id="map-fallback" class="absolute inset-0 flex flex-col items-center justify-center bg-slate-100 z-[10] p-6 text-center">
        <div class="w-10 h-10 border-4 border-indigo-600 border-t-transparent rounded-full animate-spin mb-4"></div>
        <p class="font-semibold text-slate-700">Sedang memuat peta UIN Jakarta...</p>
      </div>
    </div>

    <!-- TOMBOL SYNC / LIVE GPS TRACKER -->
    <div class="absolute bottom-6 right-6 z-[600] flex flex-col gap-2">
      <button 
        id="btn-sync-gps" 
        title="Sync Lokasi Real-time" 
        class="bg-white hover:bg-slate-50 text-slate-700 hover:text-emerald-600 font-semibold px-3.5 py-2.5 rounded-2xl shadow-2xl border border-slate-200/90 transition-all active:scale-95 flex items-center gap-2 group"
      >
        <span id="sync-icon" class="text-base">📡</span>
        <span id="sync-text" class="text-xs font-bold text-slate-700 group-hover:text-emerald-600">Sync Lokasi</span>
        <span id="sync-indicator" class="w-2.5 h-2.5 rounded-full bg-slate-300"></span>
      </button>
    </div>
  </div>

  <!-- MODAL DETAIL LAYOUT 2 KOLOM -->
  <div 
    id="detail-modal" 
    class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[9999] hidden flex items-center justify-center p-3 sm:p-6 transition-all"
  >
    <div class="bg-white w-full max-w-4xl rounded-2xl shadow-2xl border border-slate-200 max-h-[90vh] flex flex-col overflow-hidden animate-in fade-in zoom-in duration-200">
      
      <!-- Modal Header -->
      <div class="p-4 sm:p-5 bg-gradient-to-r from-emerald-800 via-teal-800 to-slate-900 text-white flex justify-between items-center border-b border-slate-700">
        <div>
          <span id="modal-category" class="inline-block bg-emerald-500/30 text-emerald-200 text-[10px] font-bold px-2 py-0.5 rounded uppercase tracking-wider mb-1">
            Kategori
          </span>
          <h2 id="modal-title" class="text-xl sm:text-2xl font-bold leading-tight">Nama Gedung</h2>
        </div>
        <button id="btn-close-modal" class="text-white/80 hover:text-white bg-white/10 hover:bg-white/20 rounded-full w-9 h-9 flex items-center justify-center transition-all text-lg font-bold">
          ✕
        </button>
      </div>

      <!-- Modal Body (2 Kolom Grid) -->
      <div class="p-4 sm:p-6 overflow-y-auto grid grid-cols-1 md:grid-cols-12 gap-6 text-slate-700">
        
        <!-- KOLOM KIRI: FOTO UTAMA & LEGENDA -->
        <div class="md:col-span-5 space-y-4 border-b md:border-b-0 md:border-r border-slate-200 pb-4 md:pb-0 md:pr-6">
          <div class="rounded-xl overflow-hidden border border-slate-200 shadow-sm bg-slate-100 aspect-video relative">
            <img 
              id="modal-image" 
              src="/map-uin.svg" 
              alt="Foto Lokasi" 
              class="w-full h-full object-cover"
              onerror="this.src='https://placehold.co/600x400/0f172a/ffffff?text=UIN+Jakarta+Location'"
            />
            <span class="absolute bottom-2 left-2 bg-black/60 backdrop-blur-md text-white text-[10px] px-2 py-0.5 rounded">
              📸 Tampilan Gedung
            </span>
          </div>

          <div id="modal-legend-section" class="hidden bg-slate-50 p-4 rounded-xl border border-slate-200">
            <h4 class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-2.5 flex items-center gap-1.5">
              <span>📌</span> Legenda & Simbol Layanan
            </h4>
            <div id="modal-legend-list" class="space-y-2 text-xs"></div>
          </div>

          <div class="bg-slate-900 text-slate-300 p-3 rounded-xl text-[11px] font-mono border border-slate-800">
            <span class="text-amber-400 font-bold block mb-0.5">🌐 Koordinat GPS:</span>
            <span id="modal-coords">[-6.00000, 106.00000]</span>
          </div>
        </div>

        <!-- KOLOM KANAN: DETAIL & LIST UNIT -->
        <div class="md:col-span-7 space-y-5">
          <div>
            <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-1.5">Tentang Gedung / Tempat</h3>
            <p id="modal-description" class="text-sm leading-relaxed text-slate-600 bg-slate-50/80 p-3.5 rounded-xl border border-slate-100"></p>
          </div>

          <div id="modal-units-section" class="hidden">
            <div class="flex items-center justify-between mb-2.5">
              <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider">🏢 Unit & Pusat Layanan di Dalam Gedung</h3>
              <span id="modal-unit-count" class="text-[10px] bg-emerald-100 text-emerald-800 font-bold px-2 py-0.5 rounded-full">
                0 Unit
              </span>
            </div>
            
            <div id="modal-units-list" class="space-y-4 max-h-[360px] overflow-y-auto pr-1"></div>
          </div>
        </div>

      </div>

      <!-- Modal Footer -->
      <div class="p-3 bg-slate-50 border-t border-slate-200 text-center text-xs text-slate-400 font-medium">
        Peta Interaktif UIN Syarif Hidayatullah Jakarta
      </div>
    </div>
  </div>
</div>

<style is:global>
  /* Animasi Denyut Titik GPS */
  @keyframes gpsPulse {
    0% {
      transform: scale(0.9);
      box-shadow: 0 0 0 0 rgba(37, 99, 235, 0.7);
    }
    70% {
      transform: scale(1.1);
      box-shadow: 0 0 0 14px rgba(37, 99, 235, 0);
    }
    100% {
      transform: scale(0.9);
      box-shadow: 0 0 0 0 rgba(37, 99, 235, 0);
    }
  }

  .gps-user-beacon {
    width: 16px;
    height: 16px;
    background-color: #2563eb;
    border: 3px solid #ffffff;
    border-radius: 50%;
    animation: gpsPulse 1.8s infinite;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
  }
</style>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  import locations from '../data/locations.json';

  declare global {
    interface Window {
      locationDataStore: Record<string, any>;
      locationMarkersStore: Record<string, L.Marker>;
      openLocationDetail: (id: string) => void;
      focusToLocation: (id: string) => void;
    }
  }

  function initMap() {
    const mapDiv = document.getElementById('map');
    if (!mapDiv) return;

    // 1. Titik Target Utama & Offset Gambar
    const centerLat = -6.3063700;
    const centerLng = 106.754790;

    const latOffset = 0.0040; 
    const lngOffset = 0.0060; 

    const imageBounds = L.latLngBounds([
      [centerLat - latOffset, centerLng - lngOffset],
      [centerLat + latOffset, centerLng + lngOffset]
    ]);

    // 2. Inisialisasi Peta
    const map = L.map('map', {
      maxBounds: imageBounds,
      maxBoundsViscosity: 1.0,
      zoomSnap: 0.1,
      zoomDelta: 0.5,
      maxZoom: 20
    });

    // 🛡️ PANE KHUSUS TITIK GPS: Z-INDEX 700 (DI ATAS SEMUA MASKING & MARKER LAIN)
    map.createPane('userLocationPane');
    map.getPane('userLocationPane')!.style.zIndex = '700';

    const fallback = document.getElementById('map-fallback');
    if (fallback) fallback.style.display = 'none';

    // 3. Tile Base OSM
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 20,
      attribution: '© OpenStreetMap contributors'
    }).addTo(map);

    // 4. MASKING POLYGON (DI PANE DEFAULT OVERLAY - Z-INDEX 400)
    const outerWorld: L.LatLngTuple[] = [
      [-90, -180],
      [90, -180],
      [90, 180],
      [-90, 180]
    ];

    const mapHole: L.LatLngTuple[] = [
      [centerLat - latOffset, centerLng - lngOffset],
      [centerLat - latOffset, centerLng + lngOffset],
      [centerLat + latOffset, centerLng + lngOffset],
      [centerLat + latOffset, centerLng - lngOffset]
    ];

    L.polygon([outerWorld, mapHole], {
      color: '#cbd5e1',
      weight: 1,
      fillColor: '#f8fafc',
      fillOpacity: 1
    }).addTo(map);

    // 5. Custom Map SVG Overlay
    const imageUrl = '/map-uin.svg';
    L.imageOverlay(imageUrl, imageBounds, {
      opacity: 1.0,
      interactive: false
    }).addTo(map);

    // 🚀 FIT OTOMATIS
    const applyExactFit = () => {
      map.invalidateSize();
      map.fitBounds(imageBounds, {
        padding: [0, 0],
        animate: false
      });
      
      const exactZoom = map.getBoundsZoom(imageBounds, false, L.point(0, 0));
      map.setMinZoom(exactZoom);
      map.setZoom(exactZoom);
    };

    requestAnimationFrame(() => {
      applyExactFit();
      setTimeout(applyExactFit, 100);
    });

    // --- FITUR LIVE SYNC GPS TRACKER ---
    let userMarker: L.Marker | null = null;
    let userAccuracyCircle: L.Circle | null = null;
    let watchId: number | null = null;
    let isTracking = false;

    const btnSync = document.getElementById('btn-sync-gps');
    const syncIndicator = document.getElementById('sync-indicator');
    const syncText = document.getElementById('sync-text');

    // Buat Icon Custom Berdenyut
    const beaconIcon = L.divIcon({
      className: '',
      html: '<div class="gps-user-beacon"></div>',
      iconSize: [16, 16],
      iconAnchor: [8, 8]
    });

    const updateGPSLocation = (pos: GeolocationPosition, autoCenter = false) => {
      const { latitude, longitude, accuracy } = pos.coords;

      // Update / Buat Lingkaran Akurasi
      if (!userAccuracyCircle) {
        userAccuracyCircle = L.circle([latitude, longitude], {
          pane: 'userLocationPane',
          radius: Math.min(accuracy, 45),
          color: '#3b82f6',
          fillColor: '#60a5fa',
          fillOpacity: 0.2,
          weight: 1.5
        }).addTo(map);
      } else {
        userAccuracyCircle.setLatLng([latitude, longitude]);
        userAccuracyCircle.setRadius(Math.min(accuracy, 45));
      }

      // Update / Buat Titik Marker User
      if (!userMarker) {
        userMarker = L.marker([latitude, longitude], {
          icon: beaconIcon,
          pane: 'userLocationPane'
        }).addTo(map);

        userMarker.bindPopup('<b class="text-xs">📍 Posisi Anda Saat Ini</b>');
      } else {
        userMarker.setLatLng([latitude, longitude]);
      }

      if (autoCenter) {
        map.flyTo([latitude, longitude], 19, { animate: true, duration: 1 });
      }
    };

    btnSync?.addEventListener('click', () => {
      if (!navigator.geolocation) {
        alert('Browser Anda tidak mendukung fitur Geolocation.');
        return;
      }

      if (isTracking) {
        // Stop Tracking
        if (watchId !== null) navigator.geolocation.clearWatch(watchId);
        watchId = null;
        isTracking = false;

        if (syncIndicator) syncIndicator.className = 'w-2.5 h-2.5 rounded-full bg-slate-300';
        if (syncText) syncText.innerText = 'Sync Lokasi';
      } else {
        // Start Live Tracking
        isTracking = true;
        if (syncIndicator) syncIndicator.className = 'w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping';
        if (syncText) syncText.innerText = 'Live Synced';

        // Panggilan awal untuk instan center
        navigator.geolocation.getCurrentPosition(
          (pos) => updateGPSLocation(pos, true),
          (err) => {
            alert('Gagal membaca GPS: ' + err.message);
            isTracking = false;
            if (syncIndicator) syncIndicator.className = 'w-2.5 h-2.5 rounded-full bg-slate-300';
            if (syncText) syncText.innerText = 'Sync Lokasi';
          },
          { enableHighAccuracy: true, timeout: 10000 }
        );

        // Pantau pergerakan terus menerus
        watchId = navigator.geolocation.watchPosition(
          (pos) => updateGPSLocation(pos, false),
          (err) => console.warn('GPS Watch error:', err.message),
          { enableHighAccuracy: true, maximumAge: 3000 }
        );
      }
    });

    // --- RENDER MARKERS DARI JSON ---
    window.locationDataStore = {};
    window.locationMarkersStore = {};

    if (Array.isArray(locations)) {
      locations.forEach((loc: any) => {
        window.locationDataStore[loc.id] = loc;

        const coords: [number, number] = [loc.coordinates[0], loc.coordinates[1]];
        let markerOptions: L.MarkerOptions = {};

        if (loc.customIcon) {
          const customMarkerIcon = L.icon({
            iconUrl: loc.customIcon,
            iconSize: [40, 50],
            iconAnchor: [20, 50],
            popupAnchor: [0, -50]
          });

          markerOptions = { icon: customMarkerIcon };
        }

        const marker = L.marker(coords, markerOptions).addTo(map);
        window.locationMarkersStore[loc.id] = marker;

        const hasUnits = Array.isArray(loc.units) && loc.units.length > 0;
        const unitBadge = hasUnits 
          ? `<span class="mt-1 inline-block text-[10px] bg-amber-100 text-amber-800 font-semibold px-1.5 py-0.5 rounded">🏢 ${loc.units.length} Unit Layanan</span>` 
          : '';

        const popupContent = `
          <div class="p-1 max-w-[210px]">
            <span class="inline-block bg-indigo-100 text-indigo-700 text-[10px] font-bold px-2 py-0.5 rounded mb-1">${loc.category}</span>
            <h4 class="font-bold text-slate-800 text-sm leading-tight">${loc.name}</h4>
            ${unitBadge}
            <p class="text-xs text-slate-600 mt-1 line-clamp-2 leading-snug">${loc.description}</p>
            <button 
              onclick="openLocationDetail('${loc.id}')"
              class="mt-2.5 w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-1.5 px-2 rounded text-[11px] transition-all flex items-center justify-center gap-1 shadow"
            >
              🔍 Lihat Details
            </button>
          </div>
        `;

        marker.bindPopup(popupContent);
      });
    }

    // --- FOCUS KE LOKASI SEARCH ---
    window.focusToLocation = (id: string) => {
      const loc = window.locationDataStore[id];
      const marker = window.locationMarkersStore[id];
      if (!loc || !marker) return;

      map.flyTo([loc.coordinates[0], loc.coordinates[1]], 19, {
        animate: true,
        duration: 0.8
      });

      marker.openPopup();
      const searchResults = document.getElementById('search-results');
      if (searchResults) searchResults.classList.add('hidden');
    };

    // --- SEARCH BAR LOGIC ---
    const searchInput = document.getElementById('search-input') as HTMLInputElement;
    const searchResults = document.getElementById('search-results') as HTMLDivElement;
    const btnClearSearch = document.getElementById('btn-clear-search') as HTMLButtonElement;

    if (searchInput && searchResults && btnClearSearch) {
      searchInput.addEventListener('input', (e) => {
        const query = (e.target as HTMLInputElement).value.trim().toLowerCase();

        if (query.length === 0) {
          searchResults.classList.add('hidden');
          btnClearSearch.classList.add('hidden');
          searchResults.innerHTML = '';
          return;
        }

        btnClearSearch.classList.remove('hidden');

        const matched = locations.filter((loc: any) => {
          const matchGedung = loc.name.toLowerCase().includes(query);
          const matchCategory = loc.category?.toLowerCase().includes(query);
          const matchUnit = Array.isArray(loc.units) && loc.units.some((u: any) => 
            u.name.toLowerCase().includes(query) || 
            u.description?.toLowerCase().includes(query) ||
            u.floor?.toLowerCase().includes(query)
          );

          return matchGedung || matchCategory || matchUnit;
        });

        if (matched.length === 0) {
          searchResults.innerHTML = `
            <div class="p-4 text-center text-xs text-slate-500 font-medium">
              Tidak menemukan tempat atau unit dengan kata kunci "<b>${query}</b>"
            </div>
          `;
        } else {
          searchResults.innerHTML = matched.map((loc: any) => {
            let matchedUnitText = '';
            if (Array.isArray(loc.units)) {
              const matchedUnits = loc.units.filter((u: any) => 
                u.name.toLowerCase().includes(query) || u.description?.toLowerCase().includes(query)
              );
              if (matchedUnits.length > 0) {
                matchedUnitText = `
                  <div class="mt-1 text-[11px] text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded flex items-center gap-1 font-medium">
                    <span>🏢</span> ${matchedUnits[0].name} (${matchedUnits[0].floor || 'Lantai ?'})
                  </div>
                `;
              }
            }

            return `
              <div 
                onclick="focusToLocation('${loc.id}')" 
                class="p-3 hover:bg-slate-50 cursor-pointer transition-all flex items-start justify-between gap-3 text-left group"
              >
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-1.5">
                    <span class="text-[10px] bg-slate-100 group-hover:bg-emerald-100 text-slate-600 group-hover:text-emerald-800 font-bold px-1.5 py-0.5 rounded">
                      ${loc.category}
                    </span>
                    <h5 class="font-bold text-slate-800 text-xs truncate group-hover:text-emerald-700 transition-colors">
                      ${loc.name}
                    </h5>
                  </div>
                  ${matchedUnitText}
                  <p class="text-[11px] text-slate-500 line-clamp-1 mt-0.5">${loc.description}</p>
                </div>
                <span class="text-slate-300 group-hover:text-emerald-600 text-xs font-bold transition-transform group-hover:translate-x-0.5">
                  ➔
                </span>
              </div>
            `;
          }).join('');
        }

        searchResults.classList.remove('hidden');
      });

      btnClearSearch.addEventListener('click', () => {
        searchInput.value = '';
        searchResults.innerHTML = '';
        searchResults.classList.add('hidden');
        btnClearSearch.classList.add('hidden');
        searchInput.focus();
      });

      document.addEventListener('click', (e) => {
        if (!searchInput.contains(e.target as Node) && !searchResults.contains(e.target as Node)) {
          searchResults.classList.add('hidden');
        }
      });
    }

    // --- MODAL DETAIL ---
    window.openLocationDetail = (locationId: string) => {
      const data = window.locationDataStore[locationId];
      if (!data) return;

      document.getElementById('modal-title')!.innerText = data.name;
      document.getElementById('modal-category')!.innerText = data.category;
      document.getElementById('modal-description')!.innerText = data.description;
      document.getElementById('modal-coords')!.innerText = `[${data.coordinates[0]}, ${data.coordinates[1]}]`;

      const modalImg = document.getElementById('modal-image') as HTMLImageElement;
      if (data.image) {
        modalImg.src = data.image;
      } else {
        modalImg.src = `https://placehold.co/600x400/0f172a/ffffff?text=${encodeURIComponent(data.name)}`;
      }

      // Render Legenda
      const legendSection = document.getElementById('modal-legend-section')!;
      const legendList = document.getElementById('modal-legend-list')!;
      legendList.innerHTML = '';

      if (Array.isArray(data.legend) && data.legend.length > 0) {
        data.legend.forEach((lg: any) => {
          const item = document.createElement('div');
          item.className = "flex items-center gap-2 bg-white p-2 rounded-lg border border-slate-100 shadow-sm";
          item.innerHTML = `<span class="text-lg">${lg.symbol}</span> <span class="text-slate-700 font-medium">${lg.label}</span>`;
          legendList.appendChild(item);
        });
        legendSection.classList.remove('hidden');
      } else {
        legendSection.classList.add('hidden');
      }

      // Render Unit-Unit
      const unitsSection = document.getElementById('modal-units-section')!;
      const unitsList = document.getElementById('modal-units-list')!;
      const unitCount = document.getElementById('modal-unit-count')!;
      unitsList.innerHTML = '';

      if (Array.isArray(data.units) && data.units.length > 0) {
        unitCount.innerText = `${data.units.length} Unit / Pusat`;
        
        data.units.forEach((u: any) => {
          const unitCard = document.createElement('div');
          unitCard.className = "bg-slate-50 border border-slate-200 rounded-xl overflow-hidden hover:border-emerald-400 hover:bg-emerald-50/20 transition-all shadow-sm flex flex-col";

          const imageHeaderHTML = u.image 
            ? `<div class="w-full h-36 bg-slate-200 relative overflow-hidden border-b border-slate-200">
                <img 
                  src="${u.image}" 
                  alt="${u.name}" 
                  class="w-full h-full object-cover" 
                  onerror="this.parentElement.style.display='none';" 
                />
               </div>`
            : '';

          const logoHTML = `<div class="text-xl bg-white p-2 rounded-lg shadow-sm border border-slate-100 flex-shrink-0 flex items-center justify-center w-9 h-9">
                              ${u.icon || '📍'}
                            </div>`;

          const floorBadgeHTML = u.floor 
            ? `<span class="text-[10px] bg-emerald-100 text-emerald-800 font-bold px-2 py-0.5 rounded-full flex-shrink-0 border border-emerald-200">
                ${u.floor}
               </span>` 
            : '';

          unitCard.innerHTML = `
            ${imageHeaderHTML}
            <div class="p-3.5 space-y-2">
              <div class="flex items-start gap-2.5">
                ${logoHTML}
                <div class="flex-1 min-w-0">
                  <div class="flex items-center justify-between gap-2">
                    <h5 class="font-bold text-slate-800 text-sm leading-snug">${u.name}</h5>
                    ${floorBadgeHTML}
                  </div>
                </div>
              </div>
              <p class="text-xs text-slate-600 leading-relaxed pl-0.5">${u.description}</p>
            </div>
          `;

          unitsList.appendChild(unitCard);
        });
        unitsSection.classList.remove('hidden');
      } else {
        unitsSection.classList.add('hidden');
      }

      document.getElementById('detail-modal')!.classList.remove('hidden');
    };

    document.getElementById('btn-close-modal')?.addEventListener('click', () => {
      document.getElementById('detail-modal')!.classList.add('hidden');
    });

    document.getElementById('detail-modal')?.addEventListener('click', (e) => {
      if (e.target === document.getElementById('detail-modal')) {
        document.getElementById('detail-modal')!.classList.add('hidden');
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMap);
  } else {
    initMap();
  }
</script>